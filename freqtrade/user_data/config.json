{
    "$schema": "https://schema.freqtrade.io/schema.json",
    "bot_name": "majvaj",
    "trading_mode": "spot",
    "dry_run": true,
    "dry_run_wallet": 1000,
    "stake_currency": "USD",
    "stake_amount": "unlimited",
    "tradable_balance_ratio": 0.99,
    "max_open_trades": 3,
    "fiat_display_currency": "USD",
    "timeframe": "1h",
    "cancel_open_orders_on_exit": false,
    "unfilledtimeout": {
        "entry": 10,
        "exit": 10,
        "unit": "minutes"
    },
    "entry_pricing": {
        "price_side": "other",
        "use_order_book": true,
        "order_book_top": 1
    },
    "exit_pricing": {
        "price_side": "other",
        "use_order_book": true,
        "order_book_top": 1
    },
    "exchange": {
        "name": "kraken",
        "key": "",
        "secret": "",
        "pair_whitelist": [
            "BTC/USD",
            "ETH/USD",
            "SOL/USD"
        ],
        "pair_blacklist": []
    },
    "pairlists": [
        {
            "method": "StaticPairList"
        }
    ],
    "force_entry_enable": false,
    "initial_state": "running",
    "internals": {
        "process_throttle_secs": 5
    },
    "freqai": {
        "enabled": true,
        "override_exchange_checks": true,
        "identifier": "majvaj-v1",
        "purge_old_models": 2,
        "train_period_days": 180,
        "backtest_period_days": 30,
        "live_retrain_hours": 24,
        "expiration_hours": 48,
        "save_backtest_models": false,
        "feature_parameters": {
            "include_timeframes": [
                "1h",
                "4h"
            ],
            "include_corr_pairlist": [
                "BTC/USD",
                "ETH/USD"
            ],
            "label_period_candles": 24,
            "include_shifted_candles": 2,
            "DI_threshold": 0.9,
            "weight_factor": 0.9,
            "principal_component_analysis": false,
            "use_SVM_to_remove_outliers": true,
            "indicator_periods_candles": [
                10,
                20,
                50
            ],
            "plot_feature_importances": 0
        },
        "data_split_parameters": {
            "test_size": 0.25,
            "shuffle": false
        },
        "model_training_parameters": {
            "n_estimators": 400,
            "learning_rate": 0.03,
            "num_leaves": 31,
            "n_jobs": 3,
            "verbosity": -1
        }
    }
}